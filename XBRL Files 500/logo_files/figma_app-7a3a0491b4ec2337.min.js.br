,{href:"https://help.figma.com/hc/articles/1500004414382-Visualize-information-using-shapes-with-text",children:"Learn more about visualizing information and building flowcharts with shapes"}),"."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"67-how-can-i-access-additional-flowcharting-features",children:"How can I access additional flowcharting features?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["Aside from building using pre-made flowchart templates or building your own flowchart with shapes and symbols, FigJam\u2019s AI feature allows you to generate customized flowcharts in seconds."," "]}),(0,n.jsxs)("p",{children:["In the top toolbar, click Generate, then choose Flowchart and add a prompt to specify any unique symbols or features you\u2019d like to add to your diagram. The more specific, the better. Once you\u2019ve nailed your prompt, hit the Generate button and watch the magic happen."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"68-will-i-know-who-made-changes-to-my-online-flowchart",children:"Will I know who made changes to my online flowchart?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["To see who\u2019s made changes to your online flowchart, click File, then View version history in the upper left corner of your board. From there, you can see who\u2019s made changes to the flowchart and when."," "]}),(0,n.jsxs)("p",{children:["To revert any changes and restore a version of your flowchart, click the three dots next to the autosaved version, then hit Restore this version. You can also name each version to make it easier to track any changes made."," "]})]})]})}function rl(){return(0,n.jsxs)("div",{className:re,children:[(0,n.jsx)("h1",{className:rt,id:"using-your-online-whiteboard",children:(0,n.jsx)("strong",{children:"Using your online whiteboard"})}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"1-what-is-an-online-whiteboard",children:"What is an online whiteboard?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsx)("p",{children:"An online whiteboard is a visual collaboration tool for teams that recreates the feeling of working together in person."}),(0,n.jsx)("p",{children:"Unlike digital documents or slides, online whiteboards provide teams space to think outside the constraints of margins and text boxes. Plus, you can express yourself and interact with teammates live on the board, making conversations more human, dynamic, and productive."})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"2-what-is-figjam",children:"What is FigJam?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["FigJam is an online whiteboard tool that offers an easy way for individuals, teams, and organizations to collaborate on projects like brainstorming, project planning, design, and meetings. With its easy-to-use collaboration features, FigJam encourages users to contribute, offer feedback, and engage with team members in real time."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"3-is-figjams-online-whiteboard-tool-free",children:"Is FigJam's online whiteboard tool free?"})," ",(0,n.jsx)(t9.k,{className:ri})," "]}),(0,n.jsxs)("p",{children:["FigJam is an online whiteboard that can be used for free forever with unlimited collaborators in three editable files. Paid plans start at just $5 per user per month, less than a third of the cost of Miro and Mural."," ",(0,n.jsx)(t7.N,{href:"https://www.figma.com/figjam-vs-miro/",children:"Compare FigJam to Miro"}),"."]}),(0,n.jsxs)("p",{children:["To learn more about FigJam plans, visit the"," ",(0,n.jsx)(t7.N,{href:"https://www.figma.com/pricing/#figjam",children:"pricing page"}),"."," "]})]}),