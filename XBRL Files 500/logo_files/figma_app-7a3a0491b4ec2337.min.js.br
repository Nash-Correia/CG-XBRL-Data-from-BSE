ttps://www.figma.com/community/",children:"Figma Community"}),". To do this, click the Share button in the top right corner of your board, then click Publish to Community. You must have \u201CCan edit\u201D access to publish the file to the Community."," "]}),(0,n.jsxs)("p",{children:[(0,n.jsx)(t7.N,{href:"https://help.figma.com/hc/articles/360040035974-Publish-files-to-the-Community",children:"Learn more about how to publish files to the Figma Community"}),"."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"59-can-i-create-a-flowchart-with-specific-symbols-on-my-online-whiteboard",children:"Can I create a flowchart with specific symbols on my online whiteboard?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["Absolutely! Flowchart symbols are shapes, lines, and arrows that represent actions or processes on your flowchart diagram. For example, a diamond shape symbolizes points where decisions are made, rectangles signify a specific action or step needed to carry out a process, and parallelograms show where users input or output data."," "]}),(0,n.jsxs)("p",{children:["FigJam\u2019s online whiteboard has over 20 shapes and symbols you can use to build a flowchart that maps user flows, systems, and processes. Read FigJam\u2019s"," ",(0,n.jsx)(t7.N,{href:"https://www.figma.com/resource-library/flowchart-symbols/",children:"flowchart symbol guide"})," ","to learn more about what each symbol means and how to effectively use them."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"60-do-i-have-to-start-my-work-with-the-ready-made-online-flowchart",children:"Do I have to start my work with the ready-made online flowchart?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["You can start your flowchart with ready-made templates or start from scratch and build your own using shapes, lines, and connectors on the FigJam whiteboard. You can also use FigJam\u2019s Generate tool, which uses the power of AI to create a customized flowchart based on the prompt you input."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"61-can-i-add-sticky-notes-to-my-flowchart-board",children:"Can I add sticky notes to my flowchart board?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["You can add sticky notes anywhere on your board when building a flowchart. Press S on your keyboard or click the stack of stickies on the bottom toolbar, then click the area of your flowchart where you\u2019d like to drop the sticky."," "]}),(0,n.jsxs)("p",{children:["You can also add connectors between sticky notes to visualize flows and create paths. Click the connector icon on the toolbar, or hit Shift + C to create an elbow connector or L for a straight line. Then, click and drag your cursor between the stickies you want to connect."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"62-can-i-add-text-to-my-flowchart",children:"Can I add text to my flowchart?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["Shapes already come with the option to add text, making it easy to add text and labels when"," ",(0,n.jsx)(t7.N,{href:"https://www.figma.com/resource-library/how-to-create-a-flow-chart/",children:"building your flowchart"}),". When resizing a shape, use the text option in the toolbar to adjust the text or make any other formatting changes to enhance readability."," "]})]}),(0,n.jsxs)("details",{className:rr,children:[(0,n.jsxs)("summary",{children:[(0,n.jsx)("span",{className:rn,id:"63-can-i-undoredo-something-on-my-flowchart",children:"Can I undo/redo something on my flowchart?"}),(0,n.jsx)(t9.k,{className:ri})]}),(0,n.jsxs)("p",{children:["Of course! To undo something on your flowchart, hit Command + Z on your keyboard. Or, na